# Copy this file to .env and fill in your values.
# Local dev uses SQLite; for production point DATABASE_URL at PostgreSQL, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/aks?schema=public"

DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"