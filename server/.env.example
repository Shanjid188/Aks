# Copy this file to .env and fill in your values.
# Local dev uses SQLite; for production point DATABASE_URL at PostgreSQL, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/aks?schema=public"

DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"
# ── Advertising & analytics tracking (all optional; leave blank to disable) ──
# Server-only secrets: never put these in the storefront (root) .env.
# Meta Conversions API — Events Manager → your dataset → Settings → Generate access token.
NEXT_PUBLIC_META_PIXEL_ID=""        # same Pixel/dataset ID as the storefront build
META_CAPI_ACCESS_TOKEN=""
# Only while testing: Events Manager → Test events → "test code". Remove in production.
META_TEST_EVENT_CODE=""
# META_GRAPH_API_VERSION="v26.0"    # override if Meta deprecates the default
# GA4 Measurement Protocol — used for server-side refunds (order cancelled/refunded/returned).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""    # same G-XXXXXXX as the storefront build
GA4_API_SECRET=""                   # GA4 Admin → Data streams → Measurement Protocol API secrets
# Everything above can instead be set in Admin → Advertising → Tracking Settings;
# a value set here always wins. Admin-entered secrets are encrypted with this
# key (32 random bytes, hex or base64 — e.g. `openssl rand -hex 32`). Keep it
# out of the database backups' location and never change it without
# re-entering the stored secrets. Leave blank to disable admin secret storage.
INTEGRATION_ENCRYPTION_KEY=""
