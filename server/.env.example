# Copy this file to .env and fill in your values.
# Local dev uses SQLite; for production point DATABASE_URL at PostgreSQL, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/aks?schema=public"

DATABASE_URL="file:./dev.db"
PORT=4000
JWT_SECRET="change-me-to-a-long-random-secret"
JWT_EXPIRES_IN="12h"
# ── Advertising & analytics tracking (all optional; leave blank to disable) ──
# Server-only secrets: never put these in the storefront (root) .env.
# Meta Conversions API — Events Manager → your dataset → Settings → Generate access token.
NEXT_PUBLIC_META_PIXEL_ID=""        # same Pixel/dataset ID as the storefront build
META_CAPI_ACCESS_TOKEN=""
# Only while testing: Events Manager → Test events → "test code". Remove in production.
META_TEST_EVENT_CODE=""
# META_GRAPH_API_VERSION="v26.0"    # override if Meta deprecates the default
# GA4 Measurement Protocol — used for server-side refunds (order cancelled/refunded/returned).
NEXT_PUBLIC_GA_MEASUREMENT_ID=""    # same G-XXXXXXX as the storefront build
GA4_API_SECRET=""                   # GA4 Admin → Data streams → Measurement Protocol API secrets
# Everything above can instead be set in Admin → Advertising → Tracking Settings;
# a value set here always wins. Admin-entered secrets are encrypted with this
# key (32 random bytes, hex or base64 — e.g. `openssl rand -hex 32`). Keep it
# out of the database backups' location and never change it without
# re-entering the stored secrets. Leave blank to disable admin secret storage.
INTEGRATION_ENCRYPTION_KEY=""

# ── Ad spend (Admin → Advertising → Integrations) ──
# Optional: these override the admin-entered values. The token needs ads_read
# on the ad account and is never sent to the browser.
# META_AD_ACCOUNT_ID=act_1234567890
# META_ADS_ACCESS_TOKEN=
# Calendar days for ad spend windows (IANA zone). Default Asia/Dhaka.
# STORE_TIMEZONE=Asia/Dhaka
# DISABLE_JOBS=true   # turns off scheduled jobs (click-ID purge, Meta Ads sync)

# ── GA4 Data API (Admin → Advertising → Traffic) ──
# Optional overrides of the admin-entered values. The service account needs
# Viewer access on the GA4 property; the key JSON is never sent to the browser.
# GA4_PROPERTY_ID=412345678
# GA4_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# ── Abandoned carts (Advertising → Abandoned Carts) ──────────────────────────
# Minutes without activity before an open checkout counts as abandoned (default 60).
# CART_ABANDON_MINUTES=60
# Opt-in contact details are erased this many days after abandonment (default 30).
# CART_CONTACT_RETENTION_DAYS=30
# Checkout sessions are deleted this many days after they started (default 180).
# CART_SESSION_RETENTION_DAYS=180
# Public storefront URL used in cart-restore links (default: the admin request's host).
# PUBLIC_SITE_URL=https://www.example.com

# ── Courier booking (Admin → Settings → Courier Booking) ─────────────────────
# Steadfast merchant panel → API → your API keys. Optional overrides of the
# admin-entered (encrypted) values; never sent to the browser.
# STEADFAST_API_KEY=
# STEADFAST_SECRET_KEY=
# Token you choose; enter the same value in Steadfast panel → Webhook (auth
# token) with callback URL https://<api-domain>/api/webhooks/courier/steadfast
# STEADFAST_WEBHOOK_TOKEN=
# Only for testing against a fake server (default https://portal.packzy.com/api/v1).
# STEADFAST_BASE_URL=
