{
  "name": "aks-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "node node_modules/tsx/dist/cli.mjs src/index.ts",
    "build": "node node_modules/typescript/bin/tsc",
    "prisma:generate": "node node_modules/prisma/build/index.js generate",
    "prisma:push": "node node_modules/prisma/build/index.js db push",
    "seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "backfill:roles": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/backfill-admin-roles.ts",
    "reset:divisions": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/reset-divisions.ts",
    "check:images": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/check-images.ts",
    "db:backup": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/db-backup.ts",
    "repair:catalog": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/repair-production-catalog.ts",
    "export:catalog": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/export-catalog.ts",
    "sync:catalog": "node --env-file=.env node_modules/tsx/dist/cli.mjs prisma/sync-catalog.ts",
    "diag:images": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/diagnose-images.ts",
    "check:image-files": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/audit-missing-images.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2"
  }
}
