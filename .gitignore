node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Backend (server/) — SQLite local database
server/prisma/dev.db
server/prisma/dev.db-journal

# Local dev/debug artifacts (logs, PIDs, command-output captures, DB backups)
*.pid
server/prisma/dev.db.bak-*
server/prisma/dev.db.backup-*

# Catalog sync transfer artifact (regenerated by `npm run export:catalog`,
# copied to the server by hand — committing a stale copy would be misleading)
server/prisma/catalog-snapshot.json
*-build-out.txt
*-build-run.txt
_pf-*-build.txt
*-run.txt
*-run-*.txt
prisma-push.txt
prisma-validate.txt
uniqueness-out.txt
sf-tsc.txt
_schema_*.txt
_fix_toasts.ps1
server/scripts/_*.ts
server/scripts/_*.mjs

# Local audit/QA screenshots and the throwaway CDP profiles they were taken
# with (_shots/, _cdp*/). Debugging output only — nothing here is part of the
# storefront, and committing it would add ~6 MB of PNGs to the history.
_shots/
_cdp*/
