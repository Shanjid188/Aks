# Copy this file to .env.local and fill in your values.
# This file is for local development only. Do not commit real secrets.

# Optional: Set your app's public URL (used for any self-referential links)
APP_URL="http://localhost:3000"

# ── Advertising & analytics (public IDs only — they are compiled into the
#    browser bundle). Leave blank to disable. Secrets such as the Meta CAPI
#    access token belong in server/.env, NEVER here.
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GA_MEASUREMENT_ID=""
