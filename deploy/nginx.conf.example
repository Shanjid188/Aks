# ─────────────────────────────────────────────────────────────────────────────
# Nginx reverse proxy for the AKS Mart VPS deployment.
# Copy to /etc/nginx/sites-available/aks-store, edit your domain, then:
#   sudo ln -s /etc/nginx/sites-available/aks-store /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   sudo certbot --nginx -d yourdomain.com -d www.yourdomain.com   # free SSL
# ─────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name yourdomain.com www.yourdomain.com;   # ← EDIT: your domain

    # Admin image uploads travel as base64 inside JSON (~12 MB max file)
    client_max_body_size 16m;

    gzip on;
    gzip_comp_level 5;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Hashed Vite build assets never change → cache aggressively
    location /assets/ {
        proxy_pass http://127.0.0.1:4000;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Everything else (SPA routes + /api/* + /images/*) → the Node app
    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
